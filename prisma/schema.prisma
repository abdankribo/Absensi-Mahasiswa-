generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  emailVerifiedAt DateTime?
  password String
  rememberToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Mahasiswa {
  nim String @id
  nama String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  absensis Absensi[]
}
model Matakuliah {
  id Int @id @default(autoincrement())
  namaMatakuliah String
  sks Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jadwals Jadwal[]
  absensis Absensi[]
}
model Jadwal {
  id Int @id @default(autoincrement())
  hari String
  jamMulai String
  matakuliahId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matakuliah Matakuliah @relation(fields: [matakuliahId], references: [id], onDelete: Restrict)
  absensis Absensi[]
  @@index([matakuliahId])
}
model Absensi {
  id Int @id @default(autoincrement())
  qrToken String @unique @default(uuid())
  mahasiswaId String
  jadwalId Int
  matakuliahId Int
  tanggalAbsensi DateTime
  status String @default("Menunggu")
  qrcodePath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mahasiswa Mahasiswa @relation(fields: [mahasiswaId], references: [nim], onDelete: Restrict)
  jadwal Jadwal @relation(fields: [jadwalId], references: [id], onDelete: Restrict)
  matakuliah Matakuliah @relation(fields: [matakuliahId], references: [id], onDelete: Restrict)
  @@index([mahasiswaId])
  @@index([jadwalId])
  @@index([matakuliahId])
  @@index([tanggalAbsensi])
}
